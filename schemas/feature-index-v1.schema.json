{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fingercd.github.io/Abnormal-Video-Detection/schemas/feature-index-v1.schema.json",
  "title": "VADBench clip feature index record v1",
  "description": "One JSONL metadata row. Dense arrays MUST remain in the referenced NPZ/NPY artifact.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "video_id",
    "clip_id",
    "clip_index",
    "encoder_fingerprint",
    "storage_format",
    "start_s",
    "end_s",
    "frame_start",
    "frame_end",
    "feature_path",
    "shape",
    "dtype",
    "arrays",
    "metadata",
    "created_at"
  ],
  "properties": {
    "schema_version": {
      "const": "vadbench.feature-index.v1"
    },
    "video_id": {
      "type": "string",
      "minLength": 1
    },
    "clip_id": {
      "type": "string",
      "minLength": 1
    },
    "clip_index": {
      "type": "integer",
      "minimum": 0
    },
    "encoder_fingerprint": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "storage_format": {
      "enum": ["npz", "npy"]
    },
    "start_s": {
      "type": "number",
      "minimum": 0
    },
    "end_s": {
      "type": "number",
      "minimum": 0
    },
    "frame_start": {
      "type": ["integer", "null"],
      "minimum": 0
    },
    "frame_end": {
      "type": ["integer", "null"],
      "minimum": 0
    },
    "feature_path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?![/\\\\])(?!.*(?:^|[/\\\\])\\.\\.(?:[/\\\\]|$)).+\\.(?:npz|npy)$"
    },
    "shape": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "integer",
        "minimum": 0
      }
    },
    "dtype": {
      "type": "string",
      "minLength": 1
    },
    "arrays": {
      "type": "object",
      "minProperties": 1,
      "required": ["features"],
      "additionalProperties": {
        "$ref": "#/$defs/arrayReference"
      }
    },
    "metadata": {
      "type": "object"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "$defs": {
    "arrayReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "shape", "dtype", "sha256", "nbytes"],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?![/\\\\])(?!.*(?:^|[/\\\\])\\.\\.(?:[/\\\\]|$)).+\\.(?:npz|npy)$"
        },
        "key": {
          "type": "string",
          "minLength": 1
        },
        "shape": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "integer",
            "minimum": 0
          }
        },
        "dtype": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "nbytes": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}
