{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/fingercd/Abnormal-Video-Detection/schemas/dataset-audit-v1.schema.json",
  "title": "VADBench UCF-Crime dataset audit report v1",
  "description": "Versioned audit of the official UCF-Crime split, landed video files, container metadata, and optional full-file SHA256 hashes.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "generated_at",
    "dataset",
    "dataset_root",
    "manifests",
    "deep_hash",
    "status",
    "passed",
    "expected",
    "observed",
    "count_checks",
    "category_distribution",
    "evaluation_readiness",
    "files",
    "duplicates",
    "hashing",
    "near_duplicate_detection",
    "videos",
    "missing_files",
    "errors",
    "warnings"
  ],
  "properties": {
    "schema_version": {
      "const": "vadbench.dataset-audit.v1"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "dataset": {
      "const": "ucf_crime"
    },
    "dataset_root": {
      "type": "string",
      "minLength": 1
    },
    "manifests": {
      "type": "object",
      "additionalProperties": false,
      "required": ["train", "test"],
      "properties": {
        "train": {"type": "string", "minLength": 1},
        "test": {"type": "string", "minLength": 1}
      }
    },
    "deep_hash": {
      "type": "boolean"
    },
    "status": {
      "enum": ["passed", "passed_with_warnings", "failed"]
    },
    "passed": {
      "type": "boolean"
    },
    "expected": {
      "$ref": "#/$defs/splitCounts"
    },
    "observed": {
      "$ref": "#/$defs/splitCounts"
    },
    "count_checks": {
      "type": "array",
      "minItems": 9,
      "maxItems": 9,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "expected", "actual", "passed"],
        "properties": {
          "name": {
            "enum": [
              "train.total",
              "train.normal",
              "train.anomaly",
              "test.total",
              "test.normal",
              "test.anomaly",
              "all.total",
              "all.normal",
              "all.anomaly"
            ]
          },
          "expected": {"type": "integer", "minimum": 0},
          "actual": {"type": "integer", "minimum": 0},
          "passed": {"type": "boolean"}
        }
      }
    },
    "category_distribution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["train", "test", "all"],
      "properties": {
        "train": {"$ref": "#/$defs/categoryCounts"},
        "test": {"$ref": "#/$defs/categoryCounts"},
        "all": {"$ref": "#/$defs/categoryCounts"}
      }
    },
    "evaluation_readiness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ready",
        "expected_test_records",
        "test_records",
        "records_with_num_frames",
        "records_with_fps",
        "records_with_frame_metadata",
        "expected_anomaly_records",
        "anomaly_records",
        "anomaly_records_with_1_or_2_positive_frame_spans",
        "expected_normal_records",
        "normal_records",
        "normal_records_without_positive_frame_spans",
        "positive_frame_spans",
        "not_ready_records"
      ],
      "properties": {
        "ready": {"type": "boolean"},
        "expected_test_records": {"const": 290},
        "test_records": {"type": "integer", "minimum": 0},
        "records_with_num_frames": {"type": "integer", "minimum": 0},
        "records_with_fps": {"type": "integer", "minimum": 0},
        "records_with_frame_metadata": {"type": "integer", "minimum": 0},
        "expected_anomaly_records": {"const": 140},
        "anomaly_records": {"type": "integer", "minimum": 0},
        "anomaly_records_with_1_or_2_positive_frame_spans": {
          "type": "integer",
          "minimum": 0
        },
        "expected_normal_records": {"const": 150},
        "normal_records": {"type": "integer", "minimum": 0},
        "normal_records_without_positive_frame_spans": {
          "type": "integer",
          "minimum": 0
        },
        "positive_frame_spans": {"type": "integer", "minimum": 0},
        "not_ready_records": {
          "type": "array",
          "items": {"$ref": "#/$defs/notReadyRecord"}
        }
      }
    },
    "files": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "manifest_records",
        "present",
        "missing",
        "stat_errors",
        "total_size_bytes",
        "probed",
        "probe_errors",
        "total_num_frames",
        "total_duration_seconds"
      ],
      "properties": {
        "manifest_records": {"type": "integer", "minimum": 0},
        "present": {"type": "integer", "minimum": 0},
        "missing": {"type": "integer", "minimum": 0},
        "stat_errors": {"type": "integer", "minimum": 0},
        "total_size_bytes": {"type": "integer", "minimum": 0},
        "probed": {"type": "integer", "minimum": 0},
        "probe_errors": {"type": "integer", "minimum": 0},
        "total_num_frames": {"type": "integer", "minimum": 0},
        "total_duration_seconds": {"type": "number", "minimum": 0}
      }
    },
    "duplicates": {
      "type": "object",
      "additionalProperties": false,
      "required": ["canonical_video_ids", "normalized_paths"],
      "properties": {
        "canonical_video_ids": {
          "type": "array",
          "items": {"$ref": "#/$defs/duplicateKeyGroup"}
        },
        "normalized_paths": {
          "type": "array",
          "items": {"$ref": "#/$defs/duplicateKeyGroup"}
        }
      }
    },
    "hashing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "requested",
        "status",
        "hashed_files",
        "hash_errors",
        "duplicate_groups"
      ],
      "properties": {
        "algorithm": {"const": "sha256"},
        "requested": {"type": "boolean"},
        "status": {"enum": ["not_run", "partial", "complete"]},
        "hashed_files": {"type": "integer", "minimum": 0},
        "hash_errors": {"type": "integer", "minimum": 0},
        "duplicate_groups": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["sha256", "occurrences"],
            "properties": {
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "occurrences": {
                "type": "array",
                "minItems": 2,
                "items": {"$ref": "#/$defs/occurrence"}
              }
            }
          }
        }
      }
    },
    "near_duplicate_detection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "method", "reason"],
      "properties": {
        "status": {"const": "not_run"},
        "method": {"type": "null"},
        "reason": {"type": "string", "minLength": 1}
      }
    },
    "videos": {
      "type": "array",
      "items": {"$ref": "#/$defs/videoAudit"}
    },
    "missing_files": {
      "type": "array",
      "items": {"$ref": "#/$defs/fileIdentity"}
    },
    "errors": {
      "type": "array",
      "items": {"$ref": "#/$defs/issue"}
    },
    "warnings": {
      "type": "array",
      "items": {"$ref": "#/$defs/issue"}
    }
  },
  "$defs": {
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["total", "normal", "anomaly"],
      "properties": {
        "total": {"type": "integer", "minimum": 0},
        "normal": {"type": "integer", "minimum": 0},
        "anomaly": {"type": "integer", "minimum": 0}
      }
    },
    "splitCounts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["train", "test", "all"],
      "properties": {
        "train": {"$ref": "#/$defs/counts"},
        "test": {"$ref": "#/$defs/counts"},
        "all": {"$ref": "#/$defs/counts"}
      }
    },
    "categoryCounts": {
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      },
      "propertyNames": {
        "type": "string",
        "minLength": 1
      }
    },
    "fileIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["split", "video_id", "path"],
      "properties": {
        "split": {"enum": ["train", "test"]},
        "video_id": {"type": "string", "minLength": 1},
        "path": {"type": "string", "minLength": 1}
      }
    },
    "notReadyRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["split", "video_id", "path", "reasons"],
      "properties": {
        "split": {"const": "test"},
        "video_id": {"type": "string", "minLength": 1},
        "path": {"type": "string", "minLength": 1},
        "reasons": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "occurrence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["split", "index", "video_id", "path"],
      "properties": {
        "split": {"enum": ["train", "test"]},
        "index": {"type": "integer", "minimum": 0},
        "video_id": {"type": "string", "minLength": 1},
        "path": {"type": "string", "minLength": 1}
      }
    },
    "duplicateKeyGroup": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "occurrences"],
      "properties": {
        "key": {"type": "string", "minLength": 1},
        "occurrences": {
          "type": "array",
          "minItems": 2,
          "items": {"$ref": "#/$defs/occurrence"}
        }
      }
    },
    "probeOk": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "num_frames",
        "fps",
        "duration_seconds",
        "width",
        "height"
      ],
      "properties": {
        "status": {"const": "ok"},
        "num_frames": {"type": "integer", "minimum": 1},
        "fps": {"type": "number", "exclusiveMinimum": 0},
        "duration_seconds": {"type": "number", "exclusiveMinimum": 0},
        "width": {"type": "integer", "minimum": 1},
        "height": {"type": "integer", "minimum": 1}
      }
    },
    "probeMissing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": {"const": "missing"}
      }
    },
    "probeError": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "message"],
      "properties": {
        "status": {"const": "error"},
        "message": {"type": "string"},
        "exception_type": {"type": "string", "minLength": 1}
      }
    },
    "videoAudit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "split",
        "index",
        "video_id",
        "path",
        "exists",
        "file_size_bytes",
        "probe"
      ],
      "properties": {
        "split": {"enum": ["train", "test"]},
        "index": {"type": "integer", "minimum": 0},
        "video_id": {"type": "string", "minLength": 1},
        "path": {"type": "string", "minLength": 1},
        "exists": {"type": "boolean"},
        "file_size_bytes": {
          "type": ["integer", "null"],
          "minimum": 0
        },
        "probe": {
          "oneOf": [
            {"$ref": "#/$defs/probeOk"},
            {"$ref": "#/$defs/probeMissing"},
            {"$ref": "#/$defs/probeError"}
          ]
        },
        "sha256": {
          "type": ["string", "null"],
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "issue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message"],
      "properties": {
        "code": {"type": "string", "minLength": 1},
        "message": {"type": "string", "minLength": 1},
        "split": {"enum": ["train", "test"]},
        "video_id": {"type": "string", "minLength": 1},
        "path": {"type": "string", "minLength": 1},
        "details": {"type": "object"}
      }
    }
  }
}
