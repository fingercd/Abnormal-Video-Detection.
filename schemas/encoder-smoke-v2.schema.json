{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fingercd.github.io/Abnormal-Video-Detection/schemas/encoder-smoke-v2.schema.json",
  "title": "VADBench real-checkpoint encoder smoke result v2",
  "description": "One fixed or streaming encoder run on a real decoded video. Failed and externally blocked runs retain the same input, asset, environment, execution, and error identity as successful runs.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "generated_at_utc",
    "run_id",
    "status",
    "encoder",
    "input",
    "outputs",
    "streaming",
    "environment",
    "assets",
    "execution",
    "provenance",
    "error"
  ],
  "properties": {
    "schema_version": {
      "const": "vadbench.encoder-smoke.v2"
    },
    "generated_at_utc": {
      "type": "string",
      "format": "date-time"
    },
    "run_id": {
      "$ref": "#/$defs/nonEmptyString"
    },
    "status": {
      "enum": ["smoke_pass", "failed", "blocked"]
    },
    "encoder": {
      "$ref": "#/$defs/encoderIdentity"
    },
    "input": {
      "$ref": "#/$defs/inputIdentity"
    },
    "outputs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/outputRecord"
      }
    },
    "streaming": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/streamingSummary"
        }
      ]
    },
    "environment": {
      "$ref": "#/$defs/environmentIdentity"
    },
    "assets": {
      "$ref": "#/$defs/assetsIdentity"
    },
    "execution": {
      "$ref": "#/$defs/execution"
    },
    "provenance": {
      "$ref": "#/$defs/provenance"
    },
    "error": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/error"
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "encoder": {
            "properties": {
              "run_mode": {
                "const": "fixed"
              }
            },
            "required": ["run_mode"]
          }
        },
        "required": ["encoder"]
      },
      "then": {
        "properties": {
          "streaming": {
            "type": "null"
          }
        }
      },
      "else": {
        "properties": {
          "streaming": {
            "$ref": "#/$defs/streamingSummary"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "smoke_pass"
          }
        },
        "required": ["status"]
      },
      "then": {
        "properties": {
          "outputs": {
            "minItems": 1,
            "items": {
              "$ref": "#/$defs/passingOutputRecord"
            }
          },
          "error": {
            "type": "null"
          },
          "execution": {
            "properties": {
              "exit_code": {
                "const": 0
              }
            }
          }
        }
      },
      "else": {
        "properties": {
          "error": {
            "$ref": "#/$defs/error"
          }
        }
      }
    }
  ],
  "$defs": {
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "nullableNonEmptyString": {
      "oneOf": [
        {
          "$ref": "#/$defs/nonEmptyString"
        },
        {
          "type": "null"
        }
      ]
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "nullableSha256": {
      "oneOf": [
        {
          "$ref": "#/$defs/sha256"
        },
        {
          "type": "null"
        }
      ]
    },
    "positiveShape": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 1
      }
    },
    "encoderIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "display_name",
        "adapter",
        "backend",
        "run_mode",
        "feature_stage"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "display_name": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "adapter": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "backend": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "run_mode": {
          "enum": ["fixed", "streaming"]
        },
        "feature_stage": {
          "$ref": "#/$defs/nonEmptyString"
        }
      }
    },
    "inputIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["video", "batches"],
      "properties": {
        "video": {
          "$ref": "#/$defs/videoIdentity"
        },
        "batches": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/inputBatch"
          }
        }
      }
    },
    "videoIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "num_frames",
        "fps",
        "duration_seconds",
        "width",
        "height"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "num_frames": {
          "type": "integer",
          "minimum": 1
        },
        "fps": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "duration_seconds": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "height": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "inputBatch": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "batch_index",
        "shape",
        "dtype",
        "layout",
        "video_ids",
        "frame_indices",
        "timestamps_seconds"
      ],
      "properties": {
        "batch_index": {
          "type": "integer",
          "minimum": 0
        },
        "shape": {
          "allOf": [
            {
              "$ref": "#/$defs/positiveShape"
            },
            {
              "minItems": 5,
              "maxItems": 5
            }
          ]
        },
        "dtype": {
          "enum": ["uint8", "torch.uint8"]
        },
        "layout": {
          "const": "BTHWC"
        },
        "video_ids": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/nonEmptyString"
          }
        },
        "frame_indices": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          }
        },
        "timestamps_seconds": {
          "type": "array",
          "items": {
            "type": "number",
            "minimum": 0
          }
        }
      }
    },
    "tensorHealth": {
      "type": "object",
      "additionalProperties": false,
      "required": ["shape", "dtype", "finite", "non_finite_count"],
      "properties": {
        "shape": {
          "$ref": "#/$defs/positiveShape"
        },
        "dtype": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "finite": {
          "type": "boolean"
        },
        "non_finite_count": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "timelineHealth": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "token_count",
        "valid_tokens_per_batch",
        "token_count_matches",
        "monotonic",
        "in_video_range",
        "video_bounds_checked",
        "has_source_frames",
        "min_start_seconds",
        "max_end_seconds",
        "min_source_frame",
        "max_source_frame_end"
      ],
      "properties": {
        "token_count": {
          "type": "integer",
          "minimum": 1
        },
        "valid_tokens_per_batch": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "integer",
            "minimum": 1
          }
        },
        "token_count_matches": {
          "type": "boolean"
        },
        "monotonic": {
          "type": "boolean"
        },
        "in_video_range": {
          "type": "boolean"
        },
        "video_bounds_checked": {
          "type": "boolean"
        },
        "has_source_frames": {
          "type": "boolean"
        },
        "min_start_seconds": {
          "type": "number",
          "minimum": 0
        },
        "max_end_seconds": {
          "type": "number",
          "minimum": 0
        },
        "min_source_frame": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "max_source_frame_end": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "outputRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "step_index",
        "passed",
        "feature_stage",
        "sequence_source",
        "identity_inferred",
        "features",
        "pooled",
        "timeline",
        "aux"
      ],
      "properties": {
        "step_index": {
          "type": "integer",
          "minimum": 0
        },
        "passed": {
          "type": "boolean"
        },
        "feature_stage": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "sequence_source": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "identity_inferred": {
          "type": "boolean"
        },
        "features": {
          "$ref": "#/$defs/tensorHealth"
        },
        "pooled": {
          "oneOf": [
            {
              "$ref": "#/$defs/tensorHealth"
            },
            {
              "type": "null"
            }
          ]
        },
        "timeline": {
          "$ref": "#/$defs/timelineHealth"
        },
        "aux": {
          "type": "object"
        }
      }
    },
    "passingOutputRecord": {
      "allOf": [
        {
          "$ref": "#/$defs/outputRecord"
        },
        {
          "properties": {
            "passed": {
              "const": true
            },
            "features": {
              "properties": {
                "finite": {
                  "const": true
                },
                "non_finite_count": {
                  "const": 0
                }
              }
            },
            "pooled": {
              "allOf": [
                {
                  "$ref": "#/$defs/tensorHealth"
                },
                {
                  "properties": {
                    "finite": {
                      "const": true
                    },
                    "non_finite_count": {
                      "const": 0
                    }
                  }
                }
              ]
            },
            "timeline": {
              "properties": {
                "token_count_matches": {
                  "const": true
                },
                "monotonic": {
                  "const": true
                },
                "in_video_range": {
                  "const": true
                },
                "video_bounds_checked": {
                  "const": true
                }
              }
            }
          }
        }
      ]
    },
    "streamingSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "chunks_requested",
        "chunks_completed",
        "state_steps",
        "state_present",
        "cache_kinds"
      ],
      "properties": {
        "chunks_requested": {
          "type": "integer",
          "minimum": 1
        },
        "chunks_completed": {
          "type": "integer",
          "minimum": 0
        },
        "state_steps": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          }
        },
        "state_present": {
          "type": "boolean"
        },
        "cache_kinds": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": ["vision_tokens", "visual_memory", "decoder_kv"]
          }
        }
      }
    },
    "environmentIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile",
        "hostname",
        "python_version",
        "python_executable",
        "device",
        "torch_version",
        "cuda_version",
        "gpu",
        "packages"
      ],
      "properties": {
        "profile": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "hostname": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "python_version": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "python_executable": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "device": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "torch_version": {
          "$ref": "#/$defs/nullableNonEmptyString"
        },
        "cuda_version": {
          "$ref": "#/$defs/nullableNonEmptyString"
        },
        "gpu": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["name", "index", "total_memory_bytes"],
              "properties": {
                "name": {
                  "$ref": "#/$defs/nonEmptyString"
                },
                "index": {
                  "type": "integer",
                  "minimum": 0
                },
                "total_memory_bytes": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            }
          ]
        },
        "packages": {
          "type": "object",
          "additionalProperties": {
            "oneOf": [
              {
                "$ref": "#/$defs/nonEmptyString"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      }
    },
    "assetsIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["upstream", "checkpoint"],
      "properties": {
        "upstream": {
          "$ref": "#/$defs/upstreamIdentity"
        },
        "checkpoint": {
          "$ref": "#/$defs/checkpointIdentity"
        }
      }
    },
    "upstreamIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repo", "revision", "license", "checkout_path"],
      "properties": {
        "repo": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "revision": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "license": {
          "$ref": "#/$defs/nullableNonEmptyString"
        },
        "checkout_path": {
          "$ref": "#/$defs/nullableNonEmptyString"
        }
      }
    },
    "checkpointIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repo",
        "revision",
        "license",
        "path",
        "sha256",
        "size_bytes"
      ],
      "properties": {
        "repo": {
          "$ref": "#/$defs/nullableNonEmptyString"
        },
        "revision": {
          "$ref": "#/$defs/nullableNonEmptyString"
        },
        "license": {
          "$ref": "#/$defs/nullableNonEmptyString"
        },
        "path": {
          "$ref": "#/$defs/nullableNonEmptyString"
        },
        "sha256": {
          "$ref": "#/$defs/nullableSha256"
        },
        "size_bytes": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "command",
        "started_at_utc",
        "finished_at_utc",
        "elapsed_seconds",
        "exit_code",
        "log_path",
        "peak_gpu_memory_bytes"
      ],
      "properties": {
        "command": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "started_at_utc": {
          "type": "string",
          "format": "date-time"
        },
        "finished_at_utc": {
          "type": "string",
          "format": "date-time"
        },
        "elapsed_seconds": {
          "type": "number",
          "minimum": 0
        },
        "exit_code": {
          "oneOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        },
        "log_path": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "peak_gpu_memory_bytes": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "git_commit",
        "git_dirty",
        "config_sha256",
        "catalog_version"
      ],
      "properties": {
        "git_commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{7,64}$"
        },
        "git_dirty": {
          "type": "boolean"
        },
        "config_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "catalog_version": {
          "$ref": "#/$defs/nonEmptyString"
        }
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "category",
        "stage",
        "message",
        "recoverable",
        "traceback",
        "evidence"
      ],
      "properties": {
        "category": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "stage": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "message": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "recoverable": {
          "type": "boolean"
        },
        "traceback": {
          "$ref": "#/$defs/nullableNonEmptyString"
        },
        "evidence": {
          "type": "object"
        }
      }
    }
  }
}
